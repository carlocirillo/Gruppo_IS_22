          <grid row="1" column="2" row-span="6" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>
      <component id="b6186" class="javax.swing.JLabel" binding="lblTitolo">
