<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.ambulatorio.boundary.AreaPersonalePazienteView">
  <grid id="root" binding="contentPane" layout-manager="GridLayoutManager" row-count="6" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="18">
    <margin top="35" left="40" bottom="35" right="40"/>
    <constraints>
      <xy x="20" y="20" width="900" height="700"/>
    </constraints>
    <properties>
      <background color="-1"/>
    </properties>
    <border type="none"/>
    <children>
      <vspacer id="vspacer_top">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
      <hspacer id="hspacer_left">
        <constraints>
          <grid row="1" column="0" row-span="4" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>
      <hspacer id="hspacer_right">
        <constraints>
          <grid row="1" column="2" row-span="4" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </hspacer>
      <component id="lbl_titolo" class="javax.swing.JLabel" binding="lblTitolo">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Segoe UI" size="32" style="1"/>
          <foreground color="-16777216"/>
          <text value="Area personale paziente"/>
        </properties>
      </component>
      <component id="lbl_info" class="javax.swing.JLabel" binding="lblInfo">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="Segoe UI" size="14"/>
          <foreground color="-6710887"/>
          <text value="Benvenuto nella tua area personale. Qui puoi gestire le tue prenotazioni."/>
        </properties>
      </component>
      <grid id="button_panel" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="15" vgap="-1">
        <margin top="10" left="0" bottom="10" right="0"/>
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-1"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="btn_prenota" class="javax.swing.JButton" binding="btnPrenotaVisita">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="200" height="45"/>
              </grid>
            </constraints>
            <properties>
              <background color="-13401132"/>
              <font name="Segoe UI" size="16" style="1"/>
              <foreground color="-1"/>
              <text value="Prenota nuova visita"/>
            </properties>
          </component>
          <component id="btn_storico" class="javax.swing.JButton" binding="btnStoricoPrenotazioni">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="220" height="45"/>
              </grid>
            </constraints>
            <properties>
              <background color="-1118482"/>
              <font name="Segoe UI" size="16" style="1"/>
              <foreground color="-16777216"/>
              <text value="Storico prenotazioni"/>
            </properties>
          </component>
          <component id="btn_logout" class="javax.swing.JButton" binding="btnLogout">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="45"/>
              </grid>
            </constraints>
            <properties>
              <background color="-1"/>
              <font name="Segoe UI" size="16" style="1"/>
              <foreground color="-4515545"/>
              <text value="Esci"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="table_panel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="10" left="0" bottom="10" right="0"/>
        <constraints>
          <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="800" height="420"/>
          </grid>
        </constraints>
        <properties>
          <background color="-1"/>
        </properties>
        <border type="none"/>
        <children>
          <scrollpane id="scroll_storico" binding="scrollStorico">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-1"/>
            </properties>
            <border type="none"/>
            <children>
              <component id="table_storico" class="javax.swing.JTable" binding="tblStoricoPrenotazioni">
                <constraints/>
                <properties/>
              </component>
            </children>
          </scrollpane>
        </children>
      </grid>
      <vspacer id="vspacer_bottom">
        <constraints>
          <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
    </children>
  </grid>
</form>
